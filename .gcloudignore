# Cache do Jekyll
.jekyll-cache/
.jekyll-metadata/
.sass-cache/

# Nunca enviar secrets para o Cloud Build
.env

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Editor / OS
.DS_Store
*.swp
*.swo

# Ferramentas locais
.cursor/
.agents/

# Docker Compose local (apenas para dev Jekyll, não necessário no Cloud Build)
docker-compose.yml
